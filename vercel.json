{
  "version": 2,
  "builds": [
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/public/index.html"
    },
    {
      "src": "/favicon.png",
      "dest": "/public/favicon.png"
    },
    {
      "src": "/weddingparty.jpg",
      "dest": "/public/weddingparty.jpg"
    },
    {
      "src": "/join",
      "status": 302,
      "headers": { "Location": "https://buy.stripe.com/aFa6oI7BU2yVeQW4qzcZa00" }
    },
    {
      "src": "/app",
      "dest": "/public/app.html"
    },
    {
      "src": "/wedding",
      "dest": "/public/wedding.html"
    },
    {
      "src": "/redeem",
      "dest": "/public/redeem.html"
    },
    {
      "src": "/gift/(.*)",
      "dest": "/public/redeem.html"
    },
    {
      "src": "/groomsmen-gifts",
      "dest": "/public/groomsmen-gifts.html"
    },
    {
      "src": "/bridesmaids-gifts",
      "dest": "/public/bridesmaids-gifts.html"
    },
    {
      "src": "/journal",
      "dest": "/public/journal.html"
    },
    {
      "src": "/privacy",
      "dest": "/public/privacy.html"
    },
    {
      "src": "/terms",
      "dest": "/public/terms.html"
    },
    {
      "src": "/caddis-stylist-demo",
      "dest": "/public/caddis-stylist-demo.html"
    },
    {
      "src": "/partners",
      "dest": "/public/partners.html"
    },
    {
      "src": "/enterprise",
      "dest": "/public/enterprise.html"
    },
    {
      "src": "/(.*\\.(?:jpg|jpeg|png|webp|gif|svg|ico))",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/public/app.html"
    }
  ]
}
